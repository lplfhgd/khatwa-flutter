rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent(parentUid) {
      return isSignedIn()
        && request.auth.uid == parentUid;
    }

    function isAnonymousUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegisteredParent() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // =========================
    // Parent-owned data
    // =========================

    match /parents/{parentUid} {
      allow read, create, update, delete:
        if isParent(parentUid);

      match /{document=**} {
        allow read, create, update, delete:
          if isParent(parentUid);
      }
    }

    // =========================
    // Pairing codes
    // =========================

    match /pairingCodes/{code} {

      allow create: if isRegisteredParent()

        // الرمز يجب أن يكون 6 أرقام.
        && code.matches('^[0-9]{6}$')

        // لا يسمح بحقوق إضافية غير المتوقعة.
        && request.resource.data.keys().hasOnly([
          'parentId',
          'childId',
          'childName',
          'used',
          'createdAt',
          'expiresAt',
          'claimedBy',
          'claimedAt'
        ])

        // ولي الأمر لا يستطيع إنشاء رمز باسم مستخدم آخر.
        && request.resource.data.parentId == request.auth.uid

        // الطفل المحدد يجب أن يكون تابعًا لولي الأمر.
        && exists(
          /databases/$(database)/documents/parents/$(request.auth.uid)/children/$(request.resource.data.childId)
        )

        // الحالة الأولية للرمز.
        && request.resource.data.used == false
        && request.resource.data.claimedBy == null
        && request.resource.data.claimedAt == null

        // createdAt يجب أن يأتي من السيرفر.
        && request.resource.data.createdAt == request.time

        // صلاحية مستقبلية لا تتجاوز 10 دقائق.
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <=
          request.time + duration.value(10, 'm');

      // لا نسمح بتحميل قائمة الرموز.
      allow list: if false;

      // قراءة رمز محدد فقط.
      allow get: if isSignedIn()
        && (
          resource.data.parentId == request.auth.uid
          || isAnonymousUser()
        );

      // جهاز الطفل المجهول فقط يستطيع استهلاك الرمز.
      allow update: if isAnonymousUser()

        // الرمز لم يستخدم بعد وما زال صالحًا.
        && resource.data.used == false
        && resource.data.expiresAt > request.time

        // بعد الاستهلاك يصبح مستخدمًا.
        && request.resource.data.used == true

        // تسجيل الجهاز الذي استخدم الرمز.
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time

        // لا يسمح بتغيير أي معلومات أخرى.
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'used',
            'claimedBy',
            'claimedAt'
          ]);

      allow delete: if false;
    }

    // =========================
    // Deny everything else
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}