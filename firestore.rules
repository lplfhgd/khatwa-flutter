rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent(parentUid) {
      return isSignedIn()
        && request.auth.uid == parentUid;
    }

    function isAnonymousUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegisteredParent() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // =========================
    // Parent-owned data
    // =========================

    match /parents/{parentUid} {

      allow read, create, update, delete:
        if isParent(parentUid);
        // =========================
// Children profiles
// =========================

match /children/{childId} {
  allow read, create, update, delete:
    if isParent(parentUid);
}

      // =========================
      // Linked child devices
      // =========================

      match /children/{childId}/linkedDevices/{deviceId} {

        // ولي الأمر يستطيع إدارة أجهزة أطفاله.
         // جهاز الطفل يستطيع قراءة سجل جهازه فقط.
          allow read: if isParent(parentUid)
          || (
          isAnonymousUser()
          && deviceId == request.auth.uid
           );

            // ولي الأمر يستطيع تعديل أو حذف الجهاز.
         // جهاز الطفل يستطيع تحديث lastSeenAt فقط في سجل جهازه.
allow update: if isParent(parentUid)

  // الجهاز نفسه يستطيع تحديث lastSeenAt فقط
  // طالما أن ربطه ما زال نشطًا.
  || (
    isAnonymousUser()

    && deviceId == request.auth.uid

    && resource.data.active == true

    && request.resource.data.active == true

    && request.resource.data.lastSeenAt == request.time

    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly([
        'lastSeenAt'
      ])
  )

  // عند ربط جهاز جديد:
  // الجهاز الجديد يستطيع تعطيل الجهاز السابق فقط
  // ضمن نفس transaction التي تنقل الجلسة إليه.
  || (
    isAnonymousUser()

    && deviceId != request.auth.uid

    && resource.data.active == true

    && request.resource.data.active == false

    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly([
        'active'
      ])

    && getAfter(
      /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/deviceSession/current
    ).data.deviceId == request.auth.uid

    && getAfter(
      /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/deviceSession/current
    ).data.active == true

    && getAfter(
      /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
    ).data.active == true
  );

allow delete:
  if isParent(parentUid);

        // جهاز الطفل يستطيع إنشاء سجل جهازه فقط،
        // وبعد استهلاك رمز ربط صحيح في نفس العملية.
        allow create: if isAnonymousUser()

          && deviceId == request.auth.uid

          && request.resource.data.keys().hasOnly([
            'active',
            'pairingCode',
            'linkedAt',
            'lastSeenAt'
          ])

          && request.resource.data.active == true

          && request.resource.data.pairingCode is string

          && request.resource.data.pairingCode.matches(
            '^[0-9]{6}$'
          )

          && request.resource.data.linkedAt == request.time

          && request.resource.data.lastSeenAt == request.time

          // نقرأ حالة رمز الربط بعد تنفيذ الـ transaction.
          && getAfter(
            /databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)
          ).data.used == true

          && getAfter(
            /databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)
          ).data.claimedBy == request.auth.uid

          && getAfter(
            /databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)
          ).data.parentId == parentUid

          && getAfter(
            /databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)
          ).data.childId == childId;
      }
      // =========================
// Current child device session
// =========================

match /children/{childId}/deviceSession/{sessionId} {

  // لا يوجد إلا مستند جلسة واحد لكل طفل.
  allow read: if isParent(parentUid)
    || (
      isAnonymousUser()
      && sessionId == 'current'
    );

  // جهاز الطفل يستطيع إنشاء الجلسة الحالية فقط
  // أثناء عملية ربط صحيحة.
  allow create: if isAnonymousUser()

    && sessionId == 'current'

    && request.resource.data.keys().hasOnly([
      'deviceId',
      'active',
      'linkedAt'
    ])

    && request.resource.data.deviceId == request.auth.uid

    && request.resource.data.active == true

    && request.resource.data.linkedAt == request.time

    && getAfter(
      /databases/$(database)/documents/pairingCodes/$(getAfter(
        /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
      ).data.pairingCode)
    ).data.used == true

    && getAfter(
      /databases/$(database)/documents/pairingCodes/$(getAfter(
        /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
      ).data.pairingCode)
    ).data.claimedBy == request.auth.uid

    && getAfter(
      /databases/$(database)/documents/pairingCodes/$(getAfter(
        /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
      ).data.pairingCode)
    ).data.parentId == parentUid

    && getAfter(
      /databases/$(database)/documents/pairingCodes/$(getAfter(
        /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
      ).data.pairingCode)
    ).data.childId == childId;

  // عند ربط جهاز جديد، تصبح الجلسة له.
  allow update: if isParent(parentUid)
    || (
      isAnonymousUser()

      && sessionId == 'current'

      && request.resource.data.keys().hasOnly([
        'deviceId',
        'active',
        'linkedAt'
      ])

      && request.resource.data.deviceId == request.auth.uid

      && request.resource.data.active == true

      && request.resource.data.linkedAt == request.time

      && getAfter(
        /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
      ).data.active == true

      && getAfter(
        /databases/$(database)/documents/pairingCodes/$(getAfter(
          /databases/$(database)/documents/parents/$(parentUid)/children/$(childId)/linkedDevices/$(request.auth.uid)
        ).data.pairingCode)
      ).data.claimedBy == request.auth.uid
    );

     allow delete: if isParent(parentUid);
  }


      match /{document=**} {
        allow read, create, update, delete:
          if isParent(parentUid);
      }
    }

    // =========================
    // Pairing codes
    // =========================

    match /pairingCodes/{code} {

      allow create: if isRegisteredParent()

        && code.matches('^[0-9]{6}$')

        && request.resource.data.keys().hasOnly([
          'parentId',
          'childId',
          'childName',
          'used',
          'createdAt',
          'expiresAt',
          'claimedBy',
          'claimedAt'
        ])

        && request.resource.data.parentId == request.auth.uid

        && exists(
          /databases/$(database)/documents/parents/$(request.auth.uid)/children/$(request.resource.data.childId)
        )

        && request.resource.data.used == false
        && request.resource.data.claimedBy == null
        && request.resource.data.claimedAt == null

        && request.resource.data.createdAt == request.time

        && request.resource.data.expiresAt > request.time

        && request.resource.data.expiresAt <=
          request.time + duration.value(10, 'm');

      allow list: if false;

      allow get: if isSignedIn()
        && (
          resource.data.parentId == request.auth.uid
          || isAnonymousUser()
        );

      allow update: if isAnonymousUser()

        && resource.data.used == false

        && resource.data.expiresAt > request.time

        && request.resource.data.used == true

        && request.resource.data.claimedBy == request.auth.uid

        && request.resource.data.claimedAt == request.time

        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'used',
            'claimedBy',
            'claimedAt'
          ]);

      allow delete: if false;
    }
    // =========================
// Communication cards
// =========================

match /cards/{cardId} {

  allow create: if isRegisteredParent()
    && request.resource.data.parentId == request.auth.uid
    && request.resource.data.childId is string
    && exists(
      /databases/$(database)/documents/parents/$(request.auth.uid)/children/$(request.resource.data.childId)
    );

  allow read: if isRegisteredParent()
    && resource.data.parentId == request.auth.uid;

  allow update: if isRegisteredParent()
    && resource.data.parentId == request.auth.uid
    && request.resource.data.parentId == request.auth.uid
    && request.resource.data.childId == resource.data.childId
    && exists(
      /databases/$(database)/documents/parents/$(request.auth.uid)/children/$(resource.data.childId)
    );

  allow delete: if isRegisteredParent()
    && resource.data.parentId == request.auth.uid;
}

// =========================
// Stories
// =========================

match /videos/{storyId} {

  allow create: if isRegisteredParent()
    && request.resource.data.parentId == request.auth.uid
    && request.resource.data.childId is string
    && exists(
      /databases/$(database)/documents/parents/$(request.auth.uid)/children/$(request.resource.data.childId)
    );

  allow read: if isRegisteredParent()
    && resource.data.parentId == request.auth.uid;

  allow update: if false;

  allow delete: if isRegisteredParent()
    && resource.data.parentId == request.auth.uid;
}

    // =========================
    // Deny everything else
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}